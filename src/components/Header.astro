---
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"
import { useTranslations, type Lang } from "@/i18n/ui"

interface Props {
  lang?: Lang
}

const currentLang: Lang = (Astro.props.lang || Astro.currentLocale || "es") as Lang
const t = useTranslations(currentLang)

const prefix = currentLang === "en" ? "/en" : ""

const navItems = [
  {
    title: t("nav.experience"),
    label: "experiencia",
    url: `${prefix}/#experiencia`,
  },
  {
    title: t("nav.projects"),
    label: "proyectos",
    url: `${prefix}/#proyectos`,
  },
  {
    title: t("nav.about"),
    label: "sobre-mi",
    url: `${prefix}/#sobre-mi`,
  },
  {
    title: t("nav.contact"),
    label: "contacto",
    url: "mailto:darbyrodriguez@outlook.com",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2 sm:mt-4 px-2"
>
  <nav
    class="header-nav flex flex-col sm:flex-row items-center justify-center gap-y-1.5 sm:gap-y-0 gap-x-1 px-3 sm:px-4 py-2 sm:py-1.5 text-sm font-medium rounded-2xl sm:rounded-full text-stone-700 dark:text-gray-300 border border-transparent shadow-sm"
  >
    <!-- Navigation Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-1 sm:gap-x-1">
      {
        navItems.map((link) => (
          <a
            class="nav-link relative text-xs sm:text-sm whitespace-nowrap block px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full transition-colors duration-200 hover:text-amber-700 dark:hover:text-amber-400"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>

    <!-- Controls (Language + Theme) -->
    <div class="flex items-center justify-center gap-2 pt-0.5 sm:pt-0 sm:ml-2 sm:pl-2 sm:border-l border-gray-300/40 dark:border-white/10 flex-shrink-0">
      <LanguageToggle currentLang={currentLang} />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a.nav-link")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-amber-700", "dark:text-amber-400", "bg-amber-600/10")
              item.classList.remove("text-stone-700", "dark:text-gray-300")
            } else {
              item.classList.remove("text-amber-700", "dark:text-amber-400", "bg-amber-600/10")
              item.classList.add("text-stone-700", "dark:text-gray-300")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  .header-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-appear {
    0% {
      background-color: transparent;
      backdrop-filter: blur(0px);
      border-color: transparent;
    }
    100% {
      background-color: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      border-color: rgba(0, 0, 0, 0.08);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.08);
    }
  }

  :global(.dark) .header-nav {
    animation: nav-appear-dark 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-appear-dark {
    0% {
      background-color: transparent;
      backdrop-filter: blur(0px);
      border-color: transparent;
    }
    100% {
      background-color: rgba(10, 10, 10, 0.85);
      backdrop-filter: blur(12px);
      border-color: rgba(255, 255, 255, 0.1);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5);
    }
  }
</style>
