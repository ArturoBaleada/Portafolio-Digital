---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
---

<div class="relative flex items-center">
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Cambiar entre modo claro y oscuro"
    title="Cambiar tema (Claro / Oscuro)"
    class="relative p-1.5 rounded-full text-gray-700 dark:text-yellow-400 hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-300 cursor-pointer flex items-center justify-center hover:scale-110 active:scale-95"
  >
    <!-- Icono Sol: se muestra en modo oscuro para invitar a cambiar a claro -->
    <span class="sun-icon hidden dark:inline-flex items-center justify-center transition-transform duration-300 hover:rotate-45">
      <SunIcon class="size-4 sm:size-5" />
    </span>
    <!-- Icono Luna: se muestra en modo claro para invitar a cambiar a oscuro -->
    <span class="moon-icon inline-flex dark:hidden items-center justify-center text-gray-700 transition-transform duration-300 hover:-rotate-12">
      <MoonIcon class="size-4 sm:size-5" />
    </span>
  </button>
</div>

<script>
  const toggleTheme = () => {
    const isDark = document.documentElement.classList.contains("dark")
    const newTheme = isDark ? "light" : "dark"

    if (newTheme === "dark") {
      document.documentElement.classList.add("dark")
    } else {
      document.documentElement.classList.remove("dark")
    }

    localStorage.setItem("theme", newTheme)
  }

  const setupThemeToggle = () => {
    const btn = document.getElementById("theme-toggle-btn")
    if (btn) {
      btn.onclick = toggleTheme
    }
  }

  // Configurar listeners
  setupThemeToggle()
  document.addEventListener("astro:page-load", setupThemeToggle)
  document.addEventListener("astro:after-swap", () => {
    const savedTheme = localStorage.getItem("theme")
    if (
      savedTheme === "dark" ||
      (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark")
    } else {
      document.documentElement.classList.remove("dark")
    }
    setupThemeToggle()
  })
</script>
