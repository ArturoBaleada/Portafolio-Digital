---
const personalImageAlt = "Darby Arturo Rodríguez Navarro"
import CvButton from "./CvButton.astro"
import { useTranslations, type Lang } from "@/i18n/ui"

interface Props {
  lang?: Lang
}

const { lang = (Astro.currentLocale || "es") as Lang } = Astro.props
const t = useTranslations(lang)
---

<article class="flex flex-col items-center justify-center gap-8 text-stone-700 dark:text-gray-300 md:flex-row">
  <div
    class="[&>p]:mb-4 [&>p>strong]:text-amber-700 dark:[&>p>strong]:text-amber-200 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty order-2 md:order-1"
  >
    <p set:html={t("about.p1")} />
    <p set:html={t("about.p2")} />
    <p set:html={t("about.p3")} />

    <div class="mt-6 pt-5 border-t border-stone-200/60 dark:border-white/10 flex flex-wrap items-center gap-3">
      <CvButton lang={lang} />
      <span class="text-xs text-stone-500 dark:text-gray-400">
        {t("about.cvSub")}
      </span>
    </div>
  </div>

  <img
    width="200"
    height="200"
    src="/darby-about.jpg"
    alt={personalImageAlt}
    class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-amber-500/5 ring-1 ring-stone-900/70 dark:ring-white/20"
    style="object-position: 50% 30%"
  />
</article>
