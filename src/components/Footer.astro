---
import HeartFilled from "./icons/HeartFilled.astro"
const currentYear = new Date().getFullYear()
---

<footer
  class="opacity-80 m-4 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
>
  <div
    class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4 flex flex-col md:flex-row items-center gap-4"
  >
    <span class="text-sm text-center text-pretty md:text-left text-zinc-800/90 dark:text-zinc-200/90"
      >&copy; {currentYear} Darby Rodríguez. Plantilla inspirada en
      <a href="https://midu.dev/" target="_blank" rel="noopener noreferrer" class="hover:underline">midudev</a>.
    </span>
    <ul
      class="flex flex-wrap items-center text-sm font-medium dark:text-white/90 gap-x-4"
    >
      <li>
        <a id="contacto" href="mailto:darbyrodriguez@outlook.com" class="hover:underline"
          >Contacto</a
        >
      </li>
      <li>
        <a href="https://github.com/ArturoBaleada" target="_blank" rel="noopener noreferrer" class="hover:underline"
          >GitHub</a
        >
      </li>
      <li>
        <a href="https://www.linkedin.com/in/darby-arturo-rodr%C3%ADguez-navarro-591b49231" target="_blank" rel="noopener noreferrer" class="hover:underline"
          >LinkedIn</a
        >
      </li>
    </ul>
  </div>
</footer>
