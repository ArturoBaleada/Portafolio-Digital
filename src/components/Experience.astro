---
import ExperienceItem from "./ExperienceItem.astro"
import experienceEs from "@/data/experience.json"
import experienceEn from "@/data/experience.en.json"
import { useTranslations, type Lang } from "@/i18n/ui"

interface Props {
  lang?: Lang
}

const { lang = (Astro.currentLocale || "es") as Lang } = Astro.props
const t = useTranslations(lang)
const experience = lang === "en" ? experienceEn : experienceEs
---

<ol class="relative mt-16" aria-label={t("experience.aria")}>
  {
    experience.map((exp, i) => (
      <li class="anim-fade-in" style={`animation-delay: ${i * 150}ms`}>
        <ExperienceItem {...exp} lang={lang} />
      </li>
    ))
  }
</ol>
