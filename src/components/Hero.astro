---
const personalImageAlt = "Darby Rodríguez"
import Badge from "@/components/Badge.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SparklesIcon from "@/components/icons/Sparkles.astro"
import PhoneIcon from "@/components/icons/Phone.astro"
import SocialPill from "@/components/SocialPill.astro"
import CvButton from "@/components/CvButton.astro"
import { useTranslations, type Lang } from "@/i18n/ui"

interface Props {
  lang?: Lang
}

const { lang = (Astro.currentLocale || "es") as Lang } = Astro.props
const t = useTranslations(lang)
---

<div class="max-w-2xl">
  <div class="anim-fade-in flex flex-wrap gap-5 mb-8 items-center">
    <!-- Avatar with ambient glow -->
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-amber-500/20 dark:bg-amber-400/10 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-2xl size-36 sm:size-48 ring-2 ring-amber-700/60 ring-offset-4 ring-offset-stone-50 dark:ring-offset-gray-950 object-cover object-top"
        src="/darby.jpg"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://www.linkedin.com/in/darby-arturo-rodr%C3%ADguez-navarro-591b49231"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge><SparklesIcon class="size-3" /> {t("hero.badge")}</Badge>
    </a>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl dark:text-white"
  >
    {t("hero.greeting")} <span class="gradient-name">Darby Rodríguez</span>
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-stone-800 dark:[&>strong]:text-amber-200 [&>strong]:text-amber-700 [&>strong]:font-semibold dark:text-gray-300"
  >
    {t("hero.experienceYears")}. <strong
      >{t("hero.role")}</strong
    > {t("hero.location")}. {t("hero.intro")}
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap items-center gap-3 sm:gap-4 mt-8"
    aria-label={t("hero.contactAria")}
  >
    <CvButton lang={lang} />
    <SocialPill href="mailto:darbyrodriguez@outlook.com">
      <MailIcon class="size-4" />
      darbyrodriguez@outlook.com
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/darby-arturo-rodr%C3%ADguez-navarro-591b49231">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://wa.me/50492887708">
      <PhoneIcon class="size-4" />
      (504) 9288-7708
    </SocialPill>
    <SocialPill href="https://github.com/ArturoBaleada">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
