---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    class="inline-flex bg-stone-100 text-stone-800 border-stone-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-white dark:bg-gray-800 border dark:border-gray-600 focus-visible:ring-amber-500/80 text-md hover:bg-amber-700 hover:border-amber-800 group max-w-fit rounded-xl hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-stone-900"
>
    <slot />
</a>
